; MODGuard Linux — RealisticSmoke configuration template.
;
; Copy this file to modguard_linux.ini in the game mod directory and adjust:
;   ~/.local/share/American Truck Simulator/mod/modguard_linux.ini
;   ~/.local/share/Euro Truck Simulator 2/mod/modguard_linux.ini
;
; Or set the MODGUARD_CONFIG environment variable to an absolute file path.
;
; Keys are case-sensitive and must live under [RealisticSmoke]. Missing or
; invalid values fall back to the defaults shown below. Inline comments after
; a value (using ; or #) are allowed. Booleans accept 1/true/yes/on and
; 0/false/no/off (case-insensitive).
;
; This template mirrors the defaults in src/exhaust_model.hpp and the sanitize
; ranges in src/config.cpp. See docs/linux-exhaust-model.md for the full
; reference.

[RealisticSmoke]

; --- Hook and behavior ---

; Enables in-process particle control. 0 keeps telemetry and diagnostics
; active but admits no particles.
SmokeHook=1

; Keeps a faint baseline of smoke while the engine is running.
ContinuousSmoke=0

; --- Global scaling ---

; Master smoke scale applied after all gates.
Intensity=0.5

; Final multiplier applied to the combined smoke value.
FinalSmokeMultiplier=0.8

; Strength of the heavy-load top-end boost. Higher widens the gap between a
; light truck and a loaded combination.
LoadSensitivity=1.0

; --- Weight and load gate ---

; Curb weight of the truck, in kilograms. Range [0, 50000].
TruckMassKg=8000

; Weight of the trailer when attached, in kilograms. Range [0, 50000].
TrailerMassKg=6000

; Steepness of the gross-weight smoke curve. Range [0.1, 10].
LoadCurvePower=2.1

; Gross weight, in kilograms, at which the load gate saturates.
; Range [1, 1000000].
GrossWeightReferenceKg=36000

; Smoke fraction for an unloaded, empty truck. Range [0, 1].
LoadBaseline=0.15

; Low end of the heavy-load emission boost. Range [0, 100].
LoadBoostMin=0.6

; High end of the heavy-load emission boost. Range [0, 100].
LoadBoostMax=2.6

; Multiplier applied to the per-layer `time_to_live` field on every admitted
; smoke spawn. Default 1 leaves the SII values untouched. A value of 20 makes
; layer 0 linger for ~60s. Range [0, 60]. 0 still passes original lifetimes.
LifetimeMultiplier=1

; --- Throttle shaping ---

; How strongly demand follows the throttle. Range [0.1, 5].
ThrottleGatePower=1.5

; --- Smoothing and transients ---

; Throttle rise time constant, in seconds. Must be >= 0.
AttackSmoothness=0.3

; Throttle fall time constant, in seconds. Must be >= 0.
ReleaseSmoothness=0.3

; Strength of the throttle-rate (turbo-lag) puff.
ThrottleTransientStrength=0.7

; Throttle rise fraction that triggers a transient puff. Range [0, 1].
ThrottleRiseThreshold=0.05

; Decay rate of the throttle transient. Must be >= 0.
ThrottleTransientDecay=0.1

; Weight of the gear-shift puff.
ShiftWeight=1.0

; Weight of the stationary-launch puff.
LaunchWeight=1.0

; --- Event and peak ---

; Slow follower of the smoothed throttle, in smoke units. When it rises above
; SustainedThrottleStrength, the added value is follower x EventStrength.
; The binary role of EventStrength was not recovered. This behavior follows
; the hypothesis in docs/01-reverse-engineering.md.
EventStrength=1.0

; Threshold, in the same units, that the steady-throttle envelope must pass
; before a sustained-throttle event adds smoke.
SustainedThrottleStrength=0.5

; Per-frame decay fraction of the session peak. Range [0, 1].
SessionPeakPercent=0.85

; --- Weighted additive terms (Windows formula) ---
;
; These keys add to the smoke before the load and throttle gates. The terms
; follow the recovered formula in MODGuard_RE.md section 6.3. The curved
; throttle term is throttle^exponent x SustainedThrottleStrength / 100, with
; exponent = 1 + ThrottleCurve/100 and ThrottleCurve = -1 selecting 1.0.
; LoadEffortWeight multiplies the computed fuel-to-air demand. The binary
; derivation of that term was not recovered. This mapping is a hypothesis.
; Each weight has a floor of 0 after sanitizing.

ThrottleCurve=45
RpmWeight=1.0
SpeedWeight=1.0
AccelerationWeight=1.0
ClutchWeight=1.0
CargoWeight=1.0
TractionAccelerationWeight=1.0
LoadEffortWeight=1.0
FreeRevWeight=1.0
